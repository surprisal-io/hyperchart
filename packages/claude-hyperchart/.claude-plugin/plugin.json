{
	"name": "hyperchart",
	"version": "0.1.1",
	"description": "Durable, typed statechart workflows whose agent actions run as Claude sessions, with a live browser inspector and steering",
	"author": { "name": "surprisal" },
	"mcpServers": {
		"hyperchart": {
			"command": "node",
			"args": ["${CLAUDE_PLUGIN_ROOT}/bin/hyperchart-mcp.mjs"]
		}
	},
	"experimental": {
		"monitors": [
			{
				"name": "hyperchart-terminal",
				"command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hyperchart-monitor.mjs\"",
				"description": "Hyperchart terminal run updates",
				"when": "always"
			}
		]
	},
	"hooks": "./hooks/hooks.json"
}

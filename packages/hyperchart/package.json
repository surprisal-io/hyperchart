{
	"name": "@surprisal/hyperchart",
	"version": "0.4.0",
	"description": "Durable, typed statechart workflows for agents and scripts",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"keywords": [
		"statecharts",
		"workflow",
		"agents",
		"durable-execution",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/surprisal-io/hyperchart.git",
		"directory": "packages/hyperchart"
	},
	"homepage": "https://github.com/surprisal-io/hyperchart#readme",
	"bugs": {
		"url": "https://github.com/surprisal-io/hyperchart/issues"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./host": {
			"types": "./dist/host/index.d.ts",
			"import": "./dist/host/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js"
		},
		"./inspect": {
			"types": "./dist/inspect/index.d.ts",
			"import": "./dist/inspect/index.js"
		},
		"./sessions": {
			"types": "./dist/sessions/index.d.ts",
			"import": "./dist/sessions/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js"
		},
		"./react/styles.css": "./dist/react/styles.css",
		"./internal/core/*": {
			"types": "./dist/core/*.d.ts",
			"import": "./dist/core/*.js"
		},
		"./internal/utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"jiti": "^2.7.0",
		"typebox": "^1.3.3",
		"zod": "^4.4.3",
		"@heroicons/react": "^2.2.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node ../../scripts/build-react-styles.mjs && node ../../scripts/build-inspector-web.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@xyflow/react": "^12.11.1",
		"elkjs": "^0.11.1",
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0",
		"react-syntax-highlighter": "^16.1.1"
	},
	"peerDependenciesMeta": {
		"@xyflow/react": {
			"optional": true
		},
		"elkjs": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"react-syntax-highlighter": {
			"optional": true
		}
	}
}

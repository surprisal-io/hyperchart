{
	"name": "pi-hyperchart-workspace",
	"version": "0.6.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/hyperchart",
		"packages/pi-hyperchart",
		"packages/claude-hyperchart"
	],
	"pi": {
		"extensions": [
			"./packages/pi-hyperchart/extensions"
		],
		"skills": [
			"./skills/pi"
		]
	},
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"clean": "node scripts/clean-dist.mjs",
		"build": "npm run clean && npm run build -w @surprisal/hyperchart && npm run build -w @surprisal/pi-hyperchart && npm run build -w @surprisal/claude-hyperchart",
		"typecheck": "npm run build && tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"check": "npm run typecheck && npm run test && npm run validate:packages",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"validate:packages": "node scripts/validate-packages.mjs"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.84.2",
		"@earendil-works/pi-tui": "^0.84.2",
		"@storybook/react-vite": "^10.1.7",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "22.19.19",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@xterm/xterm": "^6.0.0",
		"@xyflow/react": "^12.11.1",
		"elkjs": "^0.11.1",
		"jsdom": "^26.1.0",
		"pg": "^8.23.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-syntax-highlighter": "^16.1.1",
		"storybook": "^10.1.7",
		"tailwindcss": "^4.3.2",
		"typebox": "^1.3.3",
		"typescript": "5.9.3",
		"vite": "^6.0.0",
		"vitest": "^4.1.10"
	}
}

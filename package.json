{
	"name": "pi-hyperchart-workspace",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/hyperchart",
		"packages/pi-hyperchart"
	],
	"pi": {
		"extensions": ["./packages/pi-hyperchart/extensions"],
		"skills": ["./packages/pi-hyperchart/skills"]
	},
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"clean": "node scripts/clean-dist.mjs",
		"build": "npm run clean && npm run build -w @surprisal/hyperchart && npm run build -w @surprisal/pi-hyperchart",
		"typecheck": "npm run build && tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"check": "npm run typecheck && npm run test && npm run validate:packages",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"validate:packages": "node scripts/validate-packages.mjs",
		"sync:pi-docs": "node scripts/sync-pi-docs.mjs"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.80.3",
		"@earendil-works/pi-tui": "^0.80.3",
		"@storybook/react-vite": "^10.1.7",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "22.19.19",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@xyflow/react": "^12.11.1",
		"elkjs": "^0.11.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-syntax-highlighter": "^16.1.1",
		"storybook": "^10.1.7",
		"tailwindcss": "^4.3.2",
		"typebox": "^1.3.3",
		"typescript": "5.9.3",
		"vite": "^6.0.0",
		"vitest": "4.0.14"
	}
}

{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node", "vitest/globals"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"rootDir": ".",
		"outDir": "dist",
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts", "examples/**/*.ts", "tests/**/*.ts", "extensions/**/*.ts", ".pi/hypercharts/**/*.ts"]
}

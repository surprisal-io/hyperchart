{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true
	},
	"include": [
		"packages/**/*.ts",
		"packages/**/*.tsx",
		"examples/**/*.ts",
		"tests/**/*.ts",
		"tests/**/*.tsx",
		".pi/hypercharts/**/*.ts",
		".storybook/**/*.ts",
		".storybook/**/*.tsx"
	],
	"exclude": ["packages/*/dist/**"]
}
